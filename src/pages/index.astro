---
import Base from '../layouts/Base.astro';
import { site, hubs, hubNames, roasters } from '../data/site';
import { url } from '../data/url';
---
<Base>
  <div class="wrap">
    <div class="hero">
      <div>
        <h1>Larrikin: A new kind of coffee collective.</h1>
        <p class="lede">
          Buy beans from your favourite local roasters, connect with your neighbours over your shared love for coffee, and learn about coffee, equipment, gear, and techniques!
        </p>
        <div class="row">
          {site.contactEmail && <a class="btn" href="#contact">Get in touch</a>}
          {site.appUrl && <a class="btn alt" href={site.appUrl}>Member login</a>}
        </div>
      </div>
      <img src={url('/logo-lockup.png')} alt="Larrikin Coffee Collective: a magpie wearing a backwards baseball cap and holding a mug of coffee" />
    </div>
  </div>

  <section id="how">
    <div class="wrap">
      <h2>How it works</h2>
      <div class="grid three steps">
        <div class="card step">
          <h3>Order</h3>
          <p>Every fortnight a new order opens in our app. Browse the products and add what you want to your cart.</p>
        </div>
        <div class="card step">
          <h3>Pool</h3>
          <p>When the order closes, everyone's carts are combined into one group order.</p>
        </div>
        <div class="card step">
          <h3>Collect</h3>
          <p>You get an email with your total, pay by bank transfer, and confirm with the "I've paid" link. Then pick up from your local neighbourhood hub.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="community">
    <div class="wrap prose">
      <h2>Community</h2>
      <p>
        We have a Discord server where we chat about all things coffee and coordinate our coffee orders. We have relationships with the local roasters we order from. We love coffee and are passionate about connecting with those around us who share that love!
      </p>
      {roasters.length > 0 && (
        <>
          <p>
            Here are a few of the roasters we've been ordering from lately:
          </p>
          <ul class="logos">
            {roasters.map((r) => (
              <li>
                {r.href ? (
                  <a href={r.href} rel="noopener"><img src={url(r.logo)} alt={r.name} loading="lazy" /></a>
                ) : (
                  <img src={url(r.logo)} alt={r.name} loading="lazy" />
                )}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>

  <section id="hubs">
    <div class="wrap prose">
      <h2>Hubs</h2>
      <p>
        Members collect their orders from a local hub, each run by a hub organiser. We currently
        have hubs in {hubNames.join(' and ')}. Interested in starting up a hub? Drop us a line and we'll give you more info!
      </p>
      <div id="hub-map" class="hub-map" role="img" aria-label={`Map of the approximate areas covered by our hubs in ${hubNames.join(' and ')}`} data-hubs={JSON.stringify(hubs)}>
        <noscript>The map needs JavaScript. Our hubs are in {hubNames.join(' and ')}.</noscript>
      </div>
      <p class="map-note">Circles show the approximate area of each hub, not a pickup address.</p>
    </div>
  </section>

  {site.contactEmail && (
    <section id="contact">
      <div class="wrap prose">
        <h2>Get in touch</h2>
        <p>
          Interested in joining the collective or in starting your own hub? Email
          <a href={`mailto:${site.contactEmail}`}> {site.contactEmail}</a>.
        </p>
      </div>
    </section>
  )}
</Base>

<script>
  import 'maplibre-gl/dist/maplibre-gl.css';

  type Hub = { name: string; lat: number; lng: number; radiusKm: number };
  const el = document.getElementById('hub-map');

  // A circle of `radiusKm` around a point, as a GeoJSON polygon (spherical approximation).
  function circle(h: Hub, steps = 64) {
    const R = 6371;
    const lat = (h.lat * Math.PI) / 180;
    const d = h.radiusKm / R;
    const ring = Array.from({ length: steps + 1 }, (_, i) => {
      const brg = (2 * Math.PI * i) / steps;
      const la = Math.asin(Math.sin(lat) * Math.cos(d) + Math.cos(lat) * Math.sin(d) * Math.cos(brg));
      const lo = (h.lng * Math.PI) / 180 + Math.atan2(Math.sin(brg) * Math.sin(d) * Math.cos(lat), Math.cos(d) - Math.sin(lat) * Math.sin(la));
      return [(lo * 180) / Math.PI, (la * 180) / Math.PI];
    });
    return { type: 'Feature' as const, properties: {}, geometry: { type: 'Polygon' as const, coordinates: [ring] } };
  }

  // MapLibre is large, so only fetch it once the map is about to scroll into view.
  async function initMap(el: HTMLElement) {
    const [{ Map, NavigationControl, setWorkerUrl }, { default: workerUrl }] = await Promise.all([
      import('maplibre-gl'),
      import('maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'),
    ]);
    setWorkerUrl(workerUrl);
    const hubs: Hub[] = JSON.parse(el.dataset.hubs!);
    const dark = window.matchMedia('(prefers-color-scheme: dark)');
    const styleUrl = () => `https://tiles.openfreemap.org/styles/${dark.matches ? 'dark' : 'positron'}`;
    const map = new Map({ container: el, style: styleUrl(), attributionControl: { compact: true } });
    map.scrollZoom.disable();
    map.addControl(new NavigationControl({ showCompass: false }), 'top-left');

    // Fit the view to every circle's bounding box.
    const dLat = (h: Hub) => (h.radiusKm / 6371) * (180 / Math.PI);
    const dLng = (h: Hub) => dLat(h) / Math.cos((h.lat * Math.PI) / 180);
    map.fitBounds(
      [
        [Math.min(...hubs.map((h) => h.lng - dLng(h))), Math.min(...hubs.map((h) => h.lat - dLat(h)))],
        [Math.max(...hubs.map((h) => h.lng + dLng(h))), Math.max(...hubs.map((h) => h.lat + dLat(h)))],
      ],
      { padding: 16, animate: false },
    );

    // Layers vanish when the style changes (light/dark), so add them on every style load.
    map.on('style.load', () => {
      map.addSource('hubs', { type: 'geojson', data: { type: 'FeatureCollection', features: hubs.map((h) => circle(h)) } });
      map.addLayer({ id: 'hubs-fill', type: 'fill', source: 'hubs', paint: { 'fill-color': '#b4410f', 'fill-opacity': 0.2 } });
      map.addLayer({ id: 'hubs-line', type: 'line', source: 'hubs', paint: { 'line-color': '#b4410f', 'line-width': 2 } });
    });
    dark.addEventListener('change', () => map.setStyle(styleUrl()));
  }

  if (el?.dataset.hubs) {
    new IntersectionObserver(([entry], observer) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      initMap(el);
    }, { rootMargin: '400px' }).observe(el);
  }
</script>
